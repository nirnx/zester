[Unit]
Description=Zester Master
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# --component master is all that's needed: zester-watchdog derives the child
# binary and config (/etc/zester/master.yaml), the node id (the sanitized
# hostname — the master's coordination KSUID is separate and internal), and the
# creds / CA / health paths from the config's auth_dir and health_addr (:9091).
# Override any of them by appending an explicit flag.
ExecStart=/usr/local/bin/zester-watchdog --component master
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
