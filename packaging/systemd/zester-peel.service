[Unit]
Description=Zester Peel Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# ZESTER_PEEL_ID is written by postinstall into
# /etc/systemd/system/zester-peel.service.d/10-peel-id.conf as the sanitized
# short hostname, and the same value is written into peel.yaml's id: — the
# peel saves its credentials as <id>.creds under auth_dir, so the two MUST
# match. If you change id in peel.yaml, update the drop-in to match.
ExecStart=/usr/local/bin/zester-watchdog \
  --child-bin /usr/local/bin/zester-peel \
  --child-args '--config /etc/zester/peel.yaml' \
  --id ${ZESTER_PEEL_ID} \
  --component peel \
  --bootstrap-cache /var/lib/zester/nats-bootstrap.msgpack \
  --nats-ca /var/lib/zester/auth/nats-ca.crt \
  --nats-creds /var/lib/zester/auth/${ZESTER_PEEL_ID}.creds \
  --health-url http://127.0.0.1:9090/healthz \
  --ready-url http://127.0.0.1:9090/readyz \
  --soak-time 60s
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
