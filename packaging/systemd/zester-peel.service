[Unit]
Description=Zester Peel Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# --component peel is all that's needed: zester-watchdog derives the child
# binary and config (/etc/zester/peel.yaml), the node id ('id' in peel.yaml,
# else the sanitized hostname), and the creds / CA / bootstrap-cache / health
# paths from the config's auth_dir, data_dir and health_addr. The peel and the
# watchdog resolve the id from the same source, so they can never disagree.
# Override any of them by appending an explicit flag.
ExecStart=/usr/local/bin/zester-watchdog --component peel
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
