[Unit]
Description=Zester Peel Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/zester-watchdog \
  --child-bin /usr/local/bin/zester-peel \
  --child-args '--config /etc/zester/peel.yaml' \
  --id %H \
  --component peel \
  --nats-url tls://localhost:4222 \
  --nats-ca /var/lib/zester/auth/nats-ca.crt \
  --nats-creds /var/lib/zester/auth/peel.creds \
  --health-url http://127.0.0.1:9090/healthz \
  --ready-url http://127.0.0.1:9090/readyz \
  --soak-time 60s
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
